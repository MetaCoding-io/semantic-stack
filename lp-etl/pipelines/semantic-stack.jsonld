  {
    "@id": "http://localhost:9080/resources/pipelines/semantic-stack/component/c6/configuration",
    "@graph": [
      {
        "@id": "http://localhost:9080/resources/pipelines/semantic-stack/component/c6/configuration",
        "@type": [
          "http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#Configuration"
        ],
        "http://plugins.linkedpipes.com/ontology/t-sparqlConstruct#query": [
          {
            "@value": "PREFIX ss: <http://localhost:8084/vocab/>\nPREFIX schema: <http://schema.org/>\nCONSTRUCT {\n  ?a ss:transitivelyDependsOn ?b .\n  ?a schema:name ?aName .\n  ?b schema:name ?bName .\n}\nWHERE {\n  ?a ss:dependsOn+ ?b .\n  ?a schema:name ?aName .\n  ?b schema:name ?bName .\n}"
          }
        ]
      }
    ]
  },

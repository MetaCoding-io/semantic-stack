{
  "name": "semantic-stack",
  "build": { "dockerfile": "../tools/Dockerfile", "context": "../tools" },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [8080, 7000, 7001, 3030, 8082, 3333, 8083, 8084, 8085, 8087, 8888],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "stardog-union.stardog-rdf-grammars",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "python -c 'import rdflib, pyshacl, linkml; print(\"tools ready\")'",
  "remoteUser": "root"
}

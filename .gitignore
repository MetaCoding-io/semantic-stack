# Local overrides
.env
compose.override.yml

# QLever working directory: everything except the checked-in Qleverfile
qlever/*
!qlever/Qleverfile

# Generated by the tools profile
data/rml/*.rml.ttl
data/rml/output.*
data/rml/sdm-output/
data/out/*
!data/out/.gitkeep
notebooks/.ipynb_checkpoints/
**/__pycache__/

# Leftovers from local experiments
neo4j_db/
Protege-*/

# Screenshot runner
screenshots/node_modules/
screenshots/out/
screenshots/package-lock.json

# Copy to .env to override defaults. Every value below is the default used by compose.yml.

# Host ports
LANDING_PORT=8080
QLEVER_PORT=7001
QLEVER_UI_PORT=7000
FUSEKI_PORT=3030
RDF4J_PORT=8082
OPENREFINE_PORT=3333
WEBVOWL_PORT=8083
TRIFID_PORT=8084
BLUEPRINT_PORT=8085
COMUNICA_PORT=8087
OXIGRAPH_PORT=7878
JUPYTER_PORT=8888
ONTOP_PORT=8089
GRAPHDB_PORT=7200
SPARQL_PROXY_PORT=8090
SHACL_PLAY_PORT=8091
SPARKLIS_PORT=8092
SPARQL_ANYTHING_PORT=8093
PYSHACL_PORT=8099
SKOSMOS_PORT=9090
SPARNATURAL_PORT=8094
# profiles
VIRTUOSO_PORT=8890
VIRTUOSO_ISQL_PORT=1111
FUSEKI_GEOSPARQL_PORT=3031
PREZ_PORT=8000
PREZ_UI_PORT=8001
GRLC_PORT=8088
GRAPH_EXPLORER_PORT=8095
PYLODE_PORT=8096
RPT_PORT=8642
LP_ETL_PORT=9080
ITB_SHACL_PORT=8097
PROMETHEUS_PORT=9091
SPARQL_EXPORTER_PORT=9199
GRAFANA_PORT=3000
OPEN_ONTOLOGIES_PORT=8101
RUDOF_MCP_PORT=8102
SPARQL_MCP_PORT=8103
FLEXIBLE_GRAPHRAG_PORT=8104
FLEXIBLE_GRAPHRAG_UI_PORT=8105
FLEXIBLE_GRAPHRAG_MCP_PORT=3001
QDRANT_PORT=6333
OLLAMA_PORT=11434
SOLID_PORT=8100

# Credentials (local development defaults; change before exposing anything)
FUSEKI_ADMIN_PASSWORD=admin
POSTGRES_PASSWORD=stack
SPARQL_PROXY_ADMIN_PASSWORD=admin
VIRTUOSO_DBA_PASSWORD=dba
GRAFANA_ADMIN_PASSWORD=admin
OPEN_ONTOLOGIES_TOKEN=
GRLC_GITHUB_ACCESS_TOKEN=

# graphrag profile: an LLM for knowledge-graph extraction (Anthropic by default, or the ollama profile)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GRAPHRAG_LLM_PROVIDER=anthropic         # anthropic | ollama | openai | openai_like | openrouter | ...
GRAPHRAG_EMBEDDING_KIND=huggingface     # huggingface (local, no key) | ollama | openai
OLLAMA_MODEL=qwen3:8b

# Linux only: owner of the files QLever writes into ./qlever (use `id -u` / `id -g`)
QLEVER_UID=1000
QLEVER_GID=1000

# Profiles to start by default (comma-separated): qlever, oxigraph, graphdb, tools, jupyter, ontop
# COMPOSE_PROFILES=qlever,oxigraph

# Which store Trifid (and through it Blueprint) talks to, and the base the data's IRIs use
TRIFID_SPARQL_ENDPOINT_URL=http://fuseki:3030/ds/sparql
TRIFID_DATASET_BASE_URL=http://localhost:8084/
BLUEPRINT_FTS_DIALECT=fuseki

# Which store sparql-proxy (and Sparklis and Sparnatural through it) sits in front of
SPARQL_PROXY_BACKEND=http://fuseki:3030/ds/sparql

# Profile services that read a store (container URLs); all default to Fuseki
PREZ_SPARQL_ENDPOINT=http://fuseki:3030/ds/sparql
GRLC_SPARQL_ENDPOINT=http://fuseki:3030/ds/sparql
RPT_SPARQL_ENDPOINT=http://fuseki:3030/ds/sparql
GRAPH_EXPLORER_CONNECTION_URL=http://fuseki:3030
SPARQL_MCP_QUERY_URL=http://fuseki:3030/ds/sparql
SPARQL_MCP_UPDATE_URL=http://fuseki:3030/ds/update
SPARQL_MCP_GSP_URL=http://fuseki:3030/ds/data
SOLID_CONFIG=config/file.json           # config/file-root.json = writable root, no accounts; config/default.json = in-memory

# Stores Comunica federates over (space-separated). Add the others when their profiles are up:
# COMUNICA_SOURCES=sparql@http://fuseki:3030/ds/sparql sparql@http://qlever:7001 sparql@http://oxigraph:7878/query
COMUNICA_SOURCES=sparql@http://fuseki:3030/ds/sparql

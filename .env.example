# Copy to .env to override defaults. Every value below is the default used by compose.yml.

# Host ports
LANDING_PORT=8080
QLEVER_PORT=7001
QLEVER_UI_PORT=7000
FUSEKI_PORT=3030
RDF4J_PORT=8082
OPENREFINE_PORT=3333
WEBVOWL_PORT=8083
TRIFID_PORT=8084
BLUEPRINT_PORT=8085
COMUNICA_PORT=8087
OXIGRAPH_PORT=7878
JUPYTER_PORT=8888
ONTOP_PORT=8089
GRAPHDB_PORT=7200

# Credentials (local development defaults; change before exposing anything)
FUSEKI_ADMIN_PASSWORD=admin
POSTGRES_PASSWORD=stack

# Linux only: owner of the files QLever writes into ./qlever (use `id -u` / `id -g`)
QLEVER_UID=1000
QLEVER_GID=1000

# Variant selection without typing -f twice, e.g.
# COMPOSE_FILE=compose.yml:compose.oxigraph.yml

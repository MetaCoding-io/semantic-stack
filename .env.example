# Copy to .env to override defaults. Every value below is the default used by compose.yml.

# Host ports
LANDING_PORT=8080
QLEVER_PORT=7001
QLEVER_UI_PORT=7000
FUSEKI_PORT=3030
RDF4J_PORT=8082
OPENREFINE_PORT=3333
WEBVOWL_PORT=8083
TRIFID_PORT=8084
BLUEPRINT_PORT=8085
COMUNICA_PORT=8087
OXIGRAPH_PORT=7878
JUPYTER_PORT=8888
ONTOP_PORT=8089
GRAPHDB_PORT=7200
SPARQL_PROXY_PORT=8090
SHACL_PLAY_PORT=8091
SPARKLIS_PORT=8092
SPARQL_ANYTHING_PORT=8093
PYSHACL_PORT=8099
SKOSMOS_PORT=9090

# Credentials (local development defaults; change before exposing anything)
FUSEKI_ADMIN_PASSWORD=admin
POSTGRES_PASSWORD=stack
SPARQL_PROXY_ADMIN_PASSWORD=admin

# Linux only: owner of the files QLever writes into ./qlever (use `id -u` / `id -g`)
QLEVER_UID=1000
QLEVER_GID=1000

# Profiles to start by default (comma-separated): qlever, oxigraph, graphdb, tools, jupyter, ontop
# COMPOSE_PROFILES=qlever,oxigraph

# Which store Trifid (and through it Blueprint) talks to, and the base the data's IRIs use
TRIFID_SPARQL_ENDPOINT_URL=http://fuseki:3030/ds/sparql
TRIFID_DATASET_BASE_URL=http://localhost:8084/
BLUEPRINT_FTS_DIALECT=fuseki

# Which store sparql-proxy (and Sparklis through it) sits in front of
SPARQL_PROXY_BACKEND=http://fuseki:3030/ds/sparql

# Stores Comunica federates over (space-separated). Add the others when their profiles are up:
# COMUNICA_SOURCES=sparql@http://fuseki:3030/ds/sparql sparql@http://qlever:7001 sparql@http://oxigraph:7878/query
COMUNICA_SOURCES=sparql@http://fuseki:3030/ds/sparql
